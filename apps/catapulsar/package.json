{
  "name": "catapulsar-ui",
  "private": true,
  "description": "Lint and format tools for Catapulsar's static UI (orch.md §3.7, decision 94); dev-only, never in the jar.",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run format:check",
    "lint:js": "eslint --max-warnings 0 src/main/resources/static",
    "lint:css": "stylelint --max-warnings 0 \"src/main/resources/static/**/*.css\"",
    "lint:html": "html-validate \"src/main/resources/static/**/*.html\"",
    "format:check": "prettier --check src/main/resources/static",
    "format": "prettier --write src/main/resources/static"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-jsdoc": "65.4.6",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  }
}
