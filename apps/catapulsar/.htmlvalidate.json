{
  "plugins": ["./html-validate-alpine.mjs"],
  "extends": ["html-validate:recommended", "html-validate:a11y"],
  "transform": {
    "^.*\\.html$": "alpine"
  },
  "rules": {
    "doctype-style": [
      "error",
      {
        "style": "lowercase"
      }
    ],
    "void-style": [
      "error",
      {
        "style": "selfclose"
      }
    ],
    "prefer-native-element": [
      "error",
      {
        "exclude": ["button"]
      }
    ],
    "input-missing-label": "error"
  }
}
