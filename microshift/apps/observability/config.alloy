// Grafana Alloy on meloes (orch.md decision 104). One pod on the node (DaemonSet, Application alloy) that:
//   1. tails the log of every container of every namespace (/var/log/pods) and pushes it to Loki;
//   2. reads the host's journal (/run/log/journal, volatile on meloes) and pushes it to Loki;
//   3. receives the five apps' traces over OTLP and forwards them to Tempo.
// Changes here reach the pod through the ConfigMap alloy-config: the chart's reloader reloads it, no restart.
// The UI on port 12345 shows each component's health: oc -n observability port-forward ds/alloy 12345.

// ---- Logs of the pods ----------------------------------------------------------------------------------------

discovery.kubernetes "pods" {
  role = "pod"
}

// Labels of every stream: namespace, pod, container and app. CRI-O writes each container's log to
// /var/log/pods/<namespace>_<pod>_<uid>/<container>/<restart>.log.
discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  // app: the pod's label app (Pulsar, ...), replaced by app.kubernetes.io/name where it has one (our apps)
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "app"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    regex         = "(.+)"
    target_label  = "app"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    target_label  = "__path__"
    replacement   = "/var/log/pods/*$1/*.log"
  }
}

local.file_match "pods" {
  path_targets = discovery.relabel.pods.output
}

loki.source.file "pods" {
  targets    = local.file_match.pods.targets
  forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
  forward_to = [loki.write.loki.receiver]

  // CRI-O's line format: time, stream, partial flag, then the line itself
  stage.cri {}

  // Lines older than Loki accepts (reject_old_samples_max_age, 7 days) are dropped here, not sent: Loki refuses
  // them, and a refused batch held back everything after it (orch.md decision 107)
  stage.drop {
    older_than          = "167h"
    drop_counter_reason = "too_old"
  }

  // loki.source.file adds the file's path; it changes with each restart of a container and pod and container
  // already say where the line comes from
  stage.label_drop {
    values = ["filename"]
  }

  // Our apps log ECS JSON (OBS-3): the level becomes a label; the trace and span the OpenTelemetry agent puts in
  // the MDC become structured metadata, so Grafana links each line to its trace in Tempo.
  stage.match {
    selector = "{namespace=\"catacumbas69-apps\"}"

    stage.json {
      expressions = {
        level    = "log.level",   // Spring Boot's ECS nests it: {"log":{"level":"INFO",...}}
        trace_id = "trace_id",
        span_id  = "span_id",
      }
    }
    stage.labels {
      values = {
        level = "",
      }
    }
    stage.structured_metadata {
      values = {
        trace_id = "",
        span_id  = "",
      }
    }
  }
}

// ---- The host's journal ------------------------------------------------------------------------------------

// Labels: the systemd unit (microshift.service, crio.service, sshd.service, ...; empty for the kernel), the
// program that wrote it, and the priority as level.
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "identifier"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "host" {
  path          = "/run/log/journal"
  max_age       = "12h"   // on the first start, what is older is not read
  relabel_rules = loki.relabel.journal.rules
  labels        = {
    job  = "journal",
    host = "meloes",
  }
  forward_to = [loki.write.loki.receiver]
}

// ---- To Loki -----------------------------------------------------------------------------------------------

loki.write "loki" {
  endpoint {
    url = "http://loki.observability.svc.cluster.local:3100/loki/api/v1/push"
  }
}

// ---- Traces: the apps (OTLP) → Tempo -----------------------------------------------------------------------

otelcol.receiver.otlp "apps" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo.observability.svc.cluster.local:4317"
    tls {
      insecure = true   // inside the cluster
    }
  }
}
