          "refId": "A",
          "expr": "sort_desc(sum by (unit) (count_over_time({job=\"journal\", unit=~\"$unit\", identifier=~\"$identifier\", level=~\"emerg|alert|crit|err\"} |~ \"(?i)$search\" [$__range])))",
