{
  "uid": "meloes-journal",
  "title": "meloes · journal",
  "tags": [
    "logs",
    "meloes"
  ],
  "description": "O journal do meloes no Loki (orch.md decision 104): MicroShift, CRI-O, sshd, o kernel e todas as units do systemd. Volátil no meloes: o Loki é a cópia que fica.",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "unit",
        "label": "Unit",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": {
          "qryType": 1,
          "query": "label_values({job=\"journal\"}, unit)",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({job=\"journal\"}, unit)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "identifier",
        "label": "Programa",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": {
          "qryType": 1,
          "query": "label_values({job=\"journal\", unit=~\"$unit\"}, identifier)",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({job=\"journal\", unit=~\"$unit\"}, identifier)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "level",
        "label": "Prioridade",
        "type": "custom",
        "query": "emerg,alert,crit,err,warning,notice,info,debug",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "search",
        "label": "Pesquisa",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Texto ou expressão regular, sem distinguir maiúsculas",
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
